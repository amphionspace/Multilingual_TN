          {
            "op": "lit",
            "text": ", "
          },
          {
            "op": "grp",
            "g": 1,
            "as": "spellout"
          },
          {
            "op": "lit",
            "text": " "
          }
        ]
      }
    },
    {
      "id": "bn_09",
      "pattern": "{{BN_EM_DASH}}",
      "replace": " "
    },
    {
      "id": "bn_10",
      "pattern": "{{BN_PRICE_RANGE}}",
      "action": "exec",
      "params": {
        "steps": [
          {
            "op": "lit",
            "text": " "
          },
          {
            "op": "grp",
            "g": 1,
            "as": "raw"
          },
          {
            "op": "grp",
            "g": 2,
            "as": "raw"
          },
          {
            "op": "lit",
            "text": " থেকে "
          },
          {
            "op": "grp",
            "g": 3,
            "as": "raw"
          },
          {
            "op": "grp",
            "g": 4,
            "as": "raw"
          },
          {
            "op": "lit",
            "text": " "
          }
        ]
      }
    },
    {
      "id": "bn_11",
