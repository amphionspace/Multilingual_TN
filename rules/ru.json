    "cm³": "кубических сантиметров",
    "kJ": "килоджоулей",
    "kcal": "килокалорий",
    "eV": "электронвольт",
    "J/(kg·℃)": "джоулей на килограмм по Цельсию",
    "kHz": "килогерц",
