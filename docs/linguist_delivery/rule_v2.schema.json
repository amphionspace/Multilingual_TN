{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.invalid/icu/tts-rules-v2-document.json",
  "title": "TTS linguist-authored rules_v2 draft",
  "description": "Draft schema for direct authoring by linguists. Runtime loader currently supports a skeleton subset via loadRulesV2().",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "locale", "resources", "pipeline"],
  "properties": {
    "format": {
      "const": "tts_rules_v2"
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "owner": { "type": "string" },
        "version": { "type": "string" },
        "notes": { "type": "string" },
        "pipeline_kind": { "type": "string" },
        "g2p_sandhi_only": { "type": "boolean" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digit_names": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 10,
          "maxItems": 10
        },
        "month_names": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 12
        },
        "currency_map": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "unit_composite": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "unit_single": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "pattern_defs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "chem_compounds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nom", "gen", "gender"],
            "properties": {
              "nom": { "type": "string" },
              "gen": { "type": "string" },
              "gender": { "type": "string" },
              "ambig": { "type": "boolean" }
            }
          }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "items": { "$ref": "#/definitions/rule" }
        }
      }
    },
    "frontend": {
      "$ref": "#/definitions/frontend"
    }
  },
  "definitions": {
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "$ref": "#/definitions/frontendResources"
        },
        "op_defs": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": {
            "$ref": "#/definitions/frontendOpDefinition"
          }
        },
        "pre_stages": {
          "type": "array",
          "items": { "$ref": "#/definitions/frontendStage" }
        },
        "post_stages": {
          "type": "array",
          "items": { "$ref": "#/definitions/frontendStage" }
        },
        "post_stages_extra": {
          "type": "array",
          "items": { "$ref": "#/definitions/frontendStage" }
        }
      }
    },
    "frontendResources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "char_maps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "char_sets": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": { "type": "string" }
              }
            ]
          }
        },
        "constants": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "pattern_defs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "frontendOpDefinition": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/frontendStage" }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stages"],
          "properties": {
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/frontendStage" }
            }
          }
        }
      ]
    },
    "frontendStage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {
            "id": { "type": "string" },
            "op": { "type": "string", "minLength": 1 },
            "params": { "type": "object" },
            "comment": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["use"],
          "properties": {
            "id": { "type": "string" },
            "use": { "type": "string", "minLength": 1 },
            "params": { "type": "object" },
            "comment": { "type": "string" }
          }
        }
      ]
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "pattern", "replace"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "pattern": { "type": "string", "minLength": 1 },
            "replace": { "type": "string" },
            "enabled": { "type": "boolean" },
            "comment": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "pattern", "action"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "pattern": { "type": "string", "minLength": 1 },
            "action": { "type": "string", "minLength": 1 },
            "params": { "type": "object" },
            "enabled": { "type": "boolean" },
            "comment": { "type": "string" }
          }
        }
      ]
    }
  }
}
